# Provider is chosen with --provider {stub,openai,azure,bedrock}.
# Each node asks for a role; map roles to models here (ADR-0004).

# --- OpenAI ---
# OPENAI_API_KEY=
# OPS_MODEL_FAST=gpt-4o-mini
# OPS_MODEL_STRONG=gpt-4o

# --- Azure OpenAI (models are deployment names) ---
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# OPENAI_API_VERSION=2024-10-21
# OPS_MODEL_FAST=<fast-deployment>
# OPS_MODEL_STRONG=<strong-deployment>

# --- Amazon Bedrock (uses your AWS credentials and region) ---
# AWS_REGION=us-east-1
# OPS_MODEL_FAST=<bedrock model id for the fast role>
# OPS_MODEL_STRONG=<bedrock model id for the strong role>
